{
  "name": "paseo-workboard",
  "version": "0.3.4",
  "description": "Workspace tasks and draft ideas in a label-linked board or list for Paseo",
  "license": "MIT",
  "author": "fxbing",
  "homepage": "https://github.com/fxbing/paseo-workboard#readme",
  "bugs": {
    "url": "https://github.com/fxbing/paseo-workboard/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "kanban",
    "workspace",
    "tasks",
    "productivity"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxbing/paseo-workboard.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "OVERVIEW.md",
    "OVERVIEW.zh-CN.md",
    "images/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:host": "node scripts/run-host-checks.mjs",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check && npm run format:check && npm run check:package"
  },
  "devDependencies": {
    "@getpaseo/client": "0.10.0-beta.1",
    "@getpaseo/plugin": "0.10.0-beta.1",
    "@getpaseo/protocol": "0.10.0-beta.1",
    "@playwright/test": "1.56.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.0",
    "prettier": "3.6.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "~5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "zod": "^4.4.3"
  }
}
